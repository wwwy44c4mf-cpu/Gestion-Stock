{
    "name": "gestion-stock/application",
    "description": "Gestion de stocks pour interventions techniques",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*"
    },
    "autoload": {"psr-4": {"App\\": "src/"}},
    "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
    "config": {
        "allow-plugins": {"symfony/runtime": true},
        "sort-packages": true,
        "platform": {"php": "8.4.26"}
    },
    "scripts": {"test": "phpunit"}
}
