{% extends 'base.html.twig' %}
{% block title %}Mouvements · Gestion de stock{% endblock %}
{% block content %}
{% set types = {'entry':'Entrée','consumption':'Consommation','adjustment':'Ajustement','transfer':'Transfert','return':'Retour','reversal':'Annulation'} %}
<div class="page-heading"><div><p class="eyebrow">HISTORIQUE</p><h1>Mouvements</h1><p class="subtitle">Le journal des opérations de vos magasins autorisés.</p></div></div>
<section class="card">
<form method="get" class="account-filters" aria-label="Filtrer les mouvements">
{% for key,label in {'date_from':'Du','date_to':'Au'} %}<div class="field"><label for="movement-{{ key }}">{{ label }} ({{ app.user.timezone }})</label><input type="date" id="movement-{{ key }}" name="{{ key }}" value="{{ filters[key]|default('') }}"></div>{% endfor %}
<div class="field"><label for="movement-article">Article</label><select id="movement-article" name="article_id"><option value="">Tous les articles</option>{% for article in articles %}<option value="{{ article.id }}" {% if filters.article_id|default('') == article.id %}selected{% endif %}>{{ article.sku }} · {{ article.name }}{{ article.active ? '' : ' (désactivé)' }}</option>{% endfor %}</select></div>
<div class="field"><label for="movement-store">Magasin</label><select id="movement-store" name="store_id"><option value="">Tous mes magasins autorisés</option>{% for store in stores %}<option value="{{ store.id }}" {% if filters.store_id|default('') == store.id %}selected{% endif %}>{{ store.name }}{{ store.active ? '' : ' (désactivé)' }}</option>{% endfor %}</select></div>
<div class="field"><label for="movement-category">Catégorie</label><select id="movement-category" name="category_id"><option value="">Toutes les catégories</option>{% for item in categories %}<option value="{{ item.id }}" {{ filters.category_id|default('') == item.id ? 'selected' : '' }}>{{ item.name }}</option>{% endfor %}</select></div>
<div class="field"><label for="movement-type">Type</label><select id="movement-type" name="type"><option value="">Tous les types</option>{% for value,label in types %}<option value="{{ value }}" {% if filters.type|default('') == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
{% for key,label in {'author_id':'Opérateur','consumer_id':'Technicien bénéficiaire'} %}<div class="field"><label for="movement-{{ key }}">{{ label }}</label><select id="movement-{{ key }}" name="{{ key }}"><option value="">Toutes les personnes</option>{% for person in people %}<option value="{{ person.id }}" {% if filters[key]|default('') == person.id %}selected{% endif %}>{{ person.name|default('Compte anonymisé') }}</option>{% endfor %}</select></div>{% endfor %}
<div class="field"><label for="movement-sort">Trier par</label><select id="movement-sort" name="sort">{% for value,label in {'created_at':'Date','quantity':'Quantité'} %}<option value="{{ value }}" {% if filters.sort|default('created_at') == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
<div class="field"><label for="movement-order">Ordre</label><select id="movement-order" name="order">{% for value,label in {'desc':'Décroissant','asc':'Croissant'} %}<option value="{{ value }}" {% if filters.order == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
<div class="field"><label for="movement-limit">Résultats par page</label><input id="movement-limit" type="number" name="limit" min="1" max="100" value="{{ filters.limit }}"></div>
<button class="button" type="submit">Filtrer</button><a href="{{ path('movements_list',{store_id:''}) }}">Réinitialiser</a>
</form>
<p>{{ result.meta.total }} résultat{{ result.meta.total > 1 ? 's' : '' }} · Heures en {{ app.user.timezone }}.</p>
<p class="muted">Lorsqu’un transfert concerne un magasin hors de votre périmètre, ses informations extérieures sont masquées.</p>
<div class="table-scroll"><table><thead><tr><th>Date</th><th>Type</th><th>Article</th><th>Magasins</th><th>Quantité</th><th>Opérateur / bénéficiaire</th><th>Détails</th></tr></thead><tbody>
{% for movement in result.data %}<tr>
<td>{{ movement.created_at|date('d/m/Y H:i:s',app.user.timezone) }}</td><td>{{ types[movement.type] }}</td><td>{{ movement.article_sku }} · {{ movement.article_name }}</td>
<td>{{ movement.source_store_name|default(movement.restricted ? 'Magasin hors périmètre' : '—') }} → {{ movement.destination_store_name|default(movement.restricted ? 'Magasin hors périmètre' : '—') }}</td>
<td>{{ movement.quantity }}</td><td>{% if movement.restricted %}Informations masquées{% else %}{{ movement.author_name|default('Compte anonymisé') }} / {{ movement.consumer_name|default('—') }}{% endif %}</td><td><a href="{{ path('movements_detail',{id:movement.id}) }}">Consulter</a></td>
</tr>{% else %}<tr><td colspan="7">Aucun mouvement ne correspond aux filtres.</td></tr>{% endfor %}
</tbody></table></div>
{% include 'components/pagination.html.twig' with {page:result.meta.page,pages:result.meta.total_pages,route:'movements_list',parameters:filters|filter((value,key) => key != 'page')|merge({store_id:filters.store_id|default('')})} only %}
</section>
{% endblock %}
