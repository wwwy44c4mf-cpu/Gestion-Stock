<section class="card statistics-section"><h2>{{ heading }}</h2><div class="table-scroll"><table><caption>{{ heading }}</caption><thead><tr><th>{{ dimension }}</th><th>Unités sorties</th><th>Unités rendues</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.label }}<div class="statistics-bar" aria-hidden="true"><span style="width:{{ scales[loop.index0]._qs|default(0) / 100 }}%"></span></div><div class="statistics-bar statistics-bar-return" aria-hidden="true"><span style="width:{{ scales[loop.index0]._rs|default(0) / 100 }}%"></span></div></td><td>{{ item.quantity }}</td><td>{{ item.returned_quantity }}</td></tr>{% else %}<tr><td colspan="3">Aucune activité dans cette période.</td></tr>{% endfor %}</tbody></table></div></section>
