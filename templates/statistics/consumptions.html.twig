{% extends 'base.html.twig' %}
{% block title %}Statistiques de consommation · Gestion de stock{% endblock %}
{% block content %}
<p class="muted">Les consommations anonymisées après un an ne figurent plus dans les vues personnelles. Une correction liée peut également en sortir avant un an. Les quantités restent dans les statistiques globales autorisées ; pour un retour ancien, contactez un gestionnaire du magasin d’origine.</p>
{% set data = result.data %}{% set period = result.period %}
<div class="page-heading"><div><p class="eyebrow">STATISTIQUES</p><h1>{{ app.user.role == 'USER' ? 'Mes statistiques de consommation' : 'Statistiques de consommation' }}</h1><p class="subtitle">{{ app.user.role == 'USER' ? 'Vos sorties et vos retours, dans les magasins d’origine encore actifs.' : 'L’activité des magasins que vous pouvez consulter.' }}</p></div><a href="{{ path('consumptions_list',filters|filter((value,key) => key in ['date_from','date_to','store_id','category_id'])) }}">Consommations de cette période</a></div>
<section class="card statistics-section"><form method="get" class="account-filters" aria-label="Filtrer les statistiques">
{% for key,label in {'date_from':'Du','date_to':'Au'} %}<div class="field"><label for="statistics-{{ key }}">{{ label }} ({{ app.user.timezone }})</label><input type="date" name="{{ key }}" id="statistics-{{ key }}" value="{{ filters[key]|default('') }}"></div>{% endfor %}
<div class="field"><label for="statistics-store">Magasin</label><select id="statistics-store" name="store_id"><option value="">Tout mon périmètre</option>{% for store in stores %}<option value="{{ store.id }}" {{ filters.store_id|default('') == store.id ? 'selected' : '' }}>{{ store.code }} · {{ store.name }}{{ store.active ? '' : ' (désactivé)' }}</option>{% endfor %}</select></div>
<div class="field"><label for="statistics-category">Catégorie</label><select id="statistics-category" name="category_id"><option value="">Toutes les catégories</option>{% if filters.category_id|default('') and filters.category_id not in categories|map(item => item.id) %}<option selected value="{{ filters.category_id }}">Catégorie sans correspondance</option>{% endif %}{% for item in categories %}<option value="{{ item.id }}" {{ filters.category_id|default('') == item.id ? 'selected' : '' }}>{{ item.name }}{{ item.active ? '' : ' (désactivée)' }}</option>{% endfor %}</select></div>
<div class="field"><label for="statistics-granularity">Regrouper par</label><select id="statistics-granularity" name="granularity">{% for key,label in {'day':'Jour','week':'Semaine (lundi)','month':'Mois'} %}<option value="{{ key }}" {{ filters.granularity == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="field"><label for="statistics-limit">Articles par classement</label><input id="statistics-limit" type="number" name="top_limit" min="1" max="100" required value="{{ filters.top_limit }}"></div><button class="button">Filtrer</button><a href="{{ path('statistics_consumptions',{store_id:''}) }}">Réinitialiser</a>
</form></section>
<p>Les sorties et les retours sont comptés à leur propre date. Un retour peut concerner une consommation plus ancienne. Les opérations annulées ou remplacées ne contribuent pas aux statistiques ; leurs remplacements valides sont comptés à leur date.</p>
{% if period.date_from %}<p>Période : {{ period.date_from|date('d/m/Y') }} au {{ period.date_to|date('d/m/Y') }}, dates inclusives en {{ period.timezone }}. La catégorie correspond à la catégorie actuelle exacte de l’article.</p>{% endif %}
<section class="metrics" aria-label="Totaux des consommations et retours"><div class="card"><h2>Unités sorties</h2><p class="statistics-total">{{ data.totals.consumed_quantity }}</p><p>{{ data.totals.movement_count }} sortie(s) valide(s)</p></div><div class="card"><h2>Unités rendues</h2><p class="statistics-total">{{ data.totals.returned_quantity }}</p><p>{{ data.totals.return_count }} retour(s) valide(s)</p></div><div class="card"><h2>Unité commune</h2><p>Unité entière</p><p>Les retours sont présentés séparément et ne sont pas soustraits des sorties.</p></div></section>
<section class="card statistics-section"><h2>Évolution des sorties et retours</h2><p class="statistics-legend"><span>━ Sorties</span><span>┄ Retours</span></p>
{% if data.totals.movement_count == 0 and data.totals.return_count == 0 %}<p>Aucune sortie ni aucun retour dans la période sélectionnée.</p>{% endif %}
{% if data.buckets %}
<svg class="statistics-chart" viewBox="0 0 800 240" role="img" aria-labelledby="consumption-chart-title consumption-chart-description"><title id="consumption-chart-title">Évolution des quantités par {{ {'day':'jour','week':'semaine','month':'mois'}[filters.granularity] }}</title><desc id="consumption-chart-description">Sorties et retours séparés. Les valeurs exactes sont disponibles dans le tableau qui suit.</desc><text x="24" y="16" font-size="13">{{ result.charts.max_quantity }} unité(s)</text><path d="M24 20 V210 H776" fill="none" stroke="#8a9b94"/>
<polyline points="{% for item in data.buckets %}{{ data.buckets|length == 1 ? 400 : 24 + loop.index0 * 752 / (data.buckets|length - 1) }},{{ 210 - result.charts.buckets[loop.index0]._qs * 0.018 }} {% endfor %}" fill="none" stroke="#17664e" stroke-width="3"/>
<polyline points="{% for item in data.buckets %}{{ data.buckets|length == 1 ? 400 : 24 + loop.index0 * 752 / (data.buckets|length - 1) }},{{ 210 - result.charts.buckets[loop.index0]._rs * 0.018 }} {% endfor %}" fill="none" stroke="#b05f2b" stroke-width="3" stroke-dasharray="6 4"/>
{% for item in data.buckets %}{% set x = data.buckets|length == 1 ? 400 : 24 + loop.index0 * 752 / (data.buckets|length - 1) %}<circle cx="{{ x }}" cy="{{ 210 - result.charts.buckets[loop.index0]._qs * 0.018 }}" r="3" fill="#17664e"><title>{{ item.start_date }} : {{ item.consumed_quantity }} unités sorties</title></circle><circle cx="{{ x }}" cy="{{ 210 - result.charts.buckets[loop.index0]._rs * 0.018 }}" r="3" fill="#b05f2b"><title>{{ item.start_date }} : {{ item.returned_quantity }} unités rendues</title></circle>{% endfor %}
<text x="24" y="234" font-size="12">{{ (data.buckets|first).start_date|date('d/m/Y') }}</text><text x="776" y="234" text-anchor="end" font-size="12">{{ (data.buckets|last).start_date|date('d/m/Y') }}</text></svg>
<details><summary>Afficher les valeurs exactes de l’évolution</summary><p>Les semaines commencent le lundi. Les premières et dernières semaines ou mois peuvent être partiels selon les dates choisies.</p><div class="table-scroll"><table><caption>Évolution des quantités</caption><thead><tr><th>Début de période</th><th>Unités sorties</th><th>Nombre de sorties</th><th>Unités rendues</th></tr></thead><tbody>{% for item in data.buckets %}<tr><td>{{ item.start_date|date('d/m/Y') }}</td><td>{{ item.consumed_quantity }}</td><td>{{ item.movement_count }}</td><td>{{ item.returned_quantity }}</td></tr>{% endfor %}</tbody></table></div></details>
{% else %}<p>Aucune activité dans le périmètre sélectionné.</p>{% endif %}</section>
<div class="statistics-grid">{% include 'statistics/ranking.html.twig' with {heading:'Articles les plus sortis par quantité',explanation:'Classement par unités sorties, puis nombre de sorties.',items:data.top_articles,scales:result.charts.top_articles|default([]),scale_key:'_qs'} only %}{% include 'statistics/ranking.html.twig' with {heading:'Articles les plus fréquents',explanation:'Classement par nombre de sorties, puis unités sorties.',items:data.top_articles_by_count,scales:result.charts.top_articles_by_count|default([]),scale_key:'_cs'} only %}</div>
<p>Les répartitions ci-dessous incluent aussi les groupes n’ayant que des retours dans la période.</p>
<div class="statistics-grid">{% for key,heading in {'by_user':'Répartition par bénéficiaire','by_store':'Répartition par magasin','by_category':'Répartition par catégorie'} %}{% include 'statistics/distribution.html.twig' with {heading:heading,dimension:heading|replace({'Répartition par ':''}),items:attribute(data,key),scales:attribute(result.charts,key)|default([])} only %}{% endfor %}</div>
{% endblock %}
