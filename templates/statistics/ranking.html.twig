<section class="card statistics-section"><h2>{{ heading }}</h2><p>{{ explanation }}</p><div class="table-scroll"><table><caption>{{ heading }}</caption><thead><tr><th>Article</th><th>Unités sorties</th><th>Nombre de sorties</th><th>Unités rendues dans la période</th></tr></thead><tbody>{% for item in items %}<tr><td>{{ item.article_sku }} · {{ item.article_name }}<div class="statistics-bar" aria-hidden="true"><span style="width:{{ scales[loop.index0][scale_key]|default(0) / 100 }}%"></span></div></td><td>{{ item.quantity }}</td><td>{{ item.movement_count }}</td><td>{{ item.return_quantity }}</td></tr>{% else %}<tr><td colspan="4">Aucune sortie valide dans cette période.</td></tr>{% endfor %}</tbody></table></div></section>
