<div class="table-scroll" role="region" aria-label="{{ caption }}" tabindex="0"><table><caption>{{ caption }}</caption><thead><tr>{% for column in columns %}<th scope="col">{{ column }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ columns|length }}">{{ empty_message|default('Aucun résultat à afficher.') }}</td></tr>{% endfor %}</tbody></table></div>
