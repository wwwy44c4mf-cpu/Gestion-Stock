{% if pages > 1 %}<nav class="pagination" aria-label="Pagination"><span>Page {{ page }} sur {{ pages }}</span>{% if page > 1 %}<a href="{{ path(route, parameters|default({})|merge({page: page - 1})) }}" rel="prev">Page précédente</a>{% endif %}{% if page < pages %}<a href="{{ path(route, parameters|default({})|merge({page: page + 1})) }}" rel="next">Page suivante</a>{% endif %}</nav>{% endif %}
