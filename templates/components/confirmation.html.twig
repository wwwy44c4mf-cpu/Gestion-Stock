{# Include inside the protected POST form; server-side CSRF and authorization remain mandatory. #}
<div data-controller="confirmation"><button class="button" type="button" data-action="confirmation#open">{{ label }}</button><dialog data-confirmation-target="dialog" aria-labelledby="{{ id }}-title" aria-describedby="{{ id }}-description"><h2 id="{{ id }}-title">{{ title }}</h2><p id="{{ id }}-description">{{ message }}</p><div class="dialog-actions"><button type="button" data-action="confirmation#close" autofocus>Annuler</button><button type="submit" class="button">Confirmer</button></div></dialog></div>
