<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{% block title %}Gestion de stock{% endblock %}</title>
    <link rel="stylesheet" href="/assets/app.css?v={{ app_stylesheet_version }}">
    <script type="module" src="/assets/app.js?v={{ app_script_version }}"></script>
</head>
<body>
<a class="skip-link" href="#contenu">Aller au contenu</a>
<div class="shell" data-controller="navigation">
    <aside class="sidebar">
        <a class="brand" href="{{ path('home') }}"><span class="brand-icon" aria-hidden="true">▦</span> Gestion de stock</a>
        <button class="menu-toggle" type="button" data-navigation-target="toggle" data-action="navigation#toggle" aria-expanded="true" aria-controls="navigation">Menu</button>
        <nav id="navigation" aria-label="Navigation principale" data-navigation-target="menu">
            <p class="nav-label">ESPACE DE TRAVAIL</p>
            {% for item in navigation_items %}
                <a class="nav-item" href="{{ path(item.route, item.parameters) }}" {% if current_section == item.active %}aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
        </nav>
        <div class="sidebar-note"><span class="status-dot"></span> Gestion de vos magasins<br><small>Votre espace de gestion au quotidien</small></div>
    </aside>
    <div class="workspace">
        <header class="topbar">
            <span>Gestion des stocks <span class="muted">/ {{ page_title }}</span></span>
            {% if app.user %}<form method="post" action="{{ path('store_context') }}" class="store-context">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('magasin') }}">
                <label for="magasin">Magasin</label>
                <select id="magasin" name="store_id" aria-describedby="magasin-aide" {% if store_options is empty %}disabled{% endif %}>
                    <option value="">{{ store_options is empty ? 'Aucun magasin en consultation' : 'Tous mes magasins' }}</option>
                    {% for store in store_options %}<option value="{{ store.id }}" {% if selected_store == store.id %}selected{% endif %}>{{ store.name }}{{ store.active ? '' : ' (désactivé)' }}</option>{% endfor %}
                </select>
                {% if store_options is not empty %}<button class="button" type="submit">Choisir</button>{% endif %}
            </form>{% endif %}
            <div class="account-actions">
            {% if app.user %}
                <a href="{{ path('profile') }}" {% if current_section == 'profile' %}aria-current="page"{% endif %}>Mon profil</a>
                <form method="post" action="{{ path('logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="button" type="submit">Se déconnecter</button></form>
            {% endif %}
            </div>
        </header>
        <main id="contenu" tabindex="-1">
            {% if app.user %}<p id="magasin-aide" class="context-note">Le contexte sélectionné s’applique aux écrans de gestion. Vos droits restent limités aux magasins autorisés.</p>{% endif %}
            {% for type, messages in app.flashes %}{% for message in messages %}{% include 'components/notice.html.twig' with {message: message, kind: type} only %}{% endfor %}{% endfor %}
            {% block content %}{% endblock %}
        </main>
        <footer>Gestion de stock <span>Interface en français</span></footer>
    </div>
</div>
</body>
</html>
