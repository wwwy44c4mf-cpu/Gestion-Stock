{% extends 'base.html.twig' %}
{% block title %}Journal d’audit · Gestion de stock{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">TRAÇABILITÉ</p><h1>Journal d’audit</h1><p class="subtitle">{{ app.user.role == 'ADMIN' ? 'Les actions sensibles de toute l’application, y compris les événements globaux.' : 'Les actions sensibles rattachées à vos magasins actifs affectés.' }}</p></div></div>
<p>Journal en lecture seule. Les secrets, données de connexion et contenus libres sont masqués. Un transfert partiellement accessible masque aussi son acteur, sa cible et son contexte. Les événements sont rattachés au magasin enregistré lors de l’action ; les événements globaux sont réservés aux administrateurs.</p>
<section class="card"><form method="get" class="account-filters" aria-label="Filtrer le journal d’audit">
{% for key,label in {'date_from':'Du','date_to':'Au'} %}<div class="field"><label for="audit-{{ key }}">{{ label }} ({{ app.user.timezone }})</label><input type="date" name="{{ key }}" id="audit-{{ key }}" value="{{ filters[key]|default('') }}"></div>{% endfor %}
<div class="field"><label for="audit-store">Magasin</label><select name="store_id" id="audit-store"><option value="">{{ app.user.role == 'ADMIN' ? 'Tous les événements autorisés' : 'Tous mes magasins autorisés' }}</option>{% for store in stores %}<option value="{{ store.id }}" {{ filters.store_id|default('') == store.id ? 'selected' : '' }}>{{ store.code }} · {{ store.name }}{{ store.active ? '' : ' (désactivé)' }}</option>{% endfor %}</select></div>
<div class="field"><label for="audit-actor">Acteur</label><select name="actor_id" id="audit-actor"><option value="">Tous les acteurs visibles</option>{% if filters.actor_id|default('') and filters.actor_id not in options.actors|map(item => item.id) %}<option selected value="{{ filters.actor_id }}">Acteur sans correspondance visible</option>{% endif %}{% for item in options.actors %}<option value="{{ item.id }}" {{ filters.actor_id|default('') == item.id ? 'selected' : '' }}>{{ item.name|default('Acteur inconnu') }}</option>{% endfor %}</select></div>
<div class="field"><label for="audit-action">Action</label><select name="action" id="audit-action"><option value="">Toutes les actions visibles</option>{% if filters.action|default('') and filters.action not in options.actions %}<option selected value="{{ filters.action }}">{{ filters.action }}</option>{% endif %}{% for item in options.actions %}<option value="{{ item }}" {{ filters.action|default('') == item ? 'selected' : '' }}>{{ item }}</option>{% endfor %}</select></div>
<div class="field"><label for="audit-order">Ordre</label><select name="order" id="audit-order"><option value="desc" {{ filters.order == 'desc' ? 'selected' : '' }}>Plus récent d’abord</option><option value="asc" {{ filters.order == 'asc' ? 'selected' : '' }}>Plus ancien d’abord</option></select></div>
<div class="field"><label for="audit-limit">Résultats par page</label><input type="number" id="audit-limit" name="limit" min="1" max="100" value="{{ filters.limit }}"></div><button class="button">Filtrer</button><a href="{{ path('audit_list',{store_id:''}) }}">Réinitialiser</a></form>
<p>{{ result.meta.total }} événement{{ result.meta.total > 1 ? 's' : '' }} · Heures en {{ app.user.timezone }}.</p>
<div class="table-scroll"><table class="audit-table"><caption>Actions sensibles du périmètre autorisé</caption><thead><tr><th>Date</th><th>Acteur</th><th>Magasin</th><th>Action</th><th>Cible</th><th>Contexte</th></tr></thead><tbody>
{% for item in result.data %}<tr><td>{{ item.created_at|date('d/m/Y H:i:s',app.user.timezone) }}</td><td>{{ item.restricted ? 'Informations masquées' : item.actor_name|default('Système ou acteur inconnu') }}</td><td>{{ item.store_name|default('Événement global') }}</td><td>{{ item.action }}</td><td>{{ item.target_type }}{% if item.target_id %}<br><small>{{ item.target_id }}</small>{% elseif item.restricted %}<br>Informations masquées{% endif %}</td><td>{% if item.restricted %}Informations masquées{% elseif item.context is empty %}Aucun contexte public{% else %}<details><summary>Afficher le contexte</summary>{% include 'audit/context.html.twig' with {values:item.context} only %}</details>{% endif %}<small>Événement : {{ item.id }}</small></td></tr>{% else %}<tr><td colspan="6">Aucun événement ne correspond aux filtres.</td></tr>{% endfor %}
</tbody></table></div>
{% include 'components/pagination.html.twig' with {page:result.meta.page,pages:result.meta.total_pages,route:'audit_list',parameters:filters|filter((v,k) => k != 'page')|merge({store_id:filters.store_id|default('')})} only %}
</section>
{% endblock %}
