<ul class="audit-context">{% for key,value in values %}<li>{% if key matches '/^[0-9]+$/' %}{% if value is iterable %}<strong>Élément {{ key + 1 }}</strong> : {% endif %}{% else %}<strong>{{ labels[key]|default(key) }}</strong> : {% endif %}{% if value is iterable %}{% include 'audit/context.html.twig' with {values:value} only %}{% elseif value is null %}Non renseigné{% elseif value is same as(true) %}Oui{% elseif value is same as(false) %}Non{% else %}{{ labels[value]|default(value) }}{% endif %}</li>{% endfor %}</ul>
