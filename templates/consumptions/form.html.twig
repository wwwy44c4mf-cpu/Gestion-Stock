{% extends 'base.html.twig' %}
{% block title %}Enregistrer une consommation · Gestion de stock{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">SORTIE DE STOCK</p><h1>Enregistrer une consommation</h1><p class="subtitle">Indiquez les articles retirés et la personne qui les utilise.</p></div><a href="{{ path('stocks_list') }}">Consulter les stocks</a></div>
<p><a href="{{ path('consumptions_list') }}">Historique des consommations</a></p>
<p><a class="button" href="{{ path('consumptions_return_batch_new') }}">Rendre des articles</a></p>
<section class="card account-form">
{% if error %}{% include 'components/notice.html.twig' with {kind:'error',message:error} only %}<p><a href="{{ path('consumptions_new') }}">Ouvrir un nouveau formulaire</a></p>{% endif %}
{% if stores is empty %}<p class="notice">Aucun magasin actif ne permet d’enregistrer une consommation avec vos droits actuels.</p>{% endif %}
{% if articles is empty %}<p class="notice">Le catalogue ne contient aucun article actif.</p>{% endif %}
<form method="post" action="{{ path('consumptions_new') }}">
<input type="hidden" name="_csrf_token" value="{{ csrf_token('stock_consumption') }}"><input type="hidden" name="_movement_key" value="{{ movement_key }}">
<div class="field"><label for="consumption-store">Magasin (obligatoire)</label><select id="consumption-store" name="store_id" required><option value="">Choisir un magasin</option>{% for store in stores %}<option value="{{ store.id }}" {% if item.store_id == store.id %}selected{% endif %}>{{ store.code }} · {{ store.name }}</option>{% endfor %}</select></div>
<div class="field"><label for="consumption-article">Article (obligatoire)</label><select id="consumption-article" name="article_id" required><option value="">Choisir un article</option>{% for article in articles %}<option value="{{ article.id }}" {% if item.article_id == article.id %}selected{% endif %}>{{ article.sku }} · {{ article.name }}</option>{% endfor %}</select></div>
{% if can_choose_beneficiary %}<div class="field"><label for="consumption-beneficiary">Technicien bénéficiaire (obligatoire)</label><select id="consumption-beneficiary" name="consumer_id" required><option value="">Choisir un technicien</option>{% for beneficiary in beneficiaries %}<option value="{{ beneficiary.id }}" {% if item.consumer_id == beneficiary.id %}selected{% endif %}>{{ beneficiary.name }}</option>{% endfor %}</select><p class="muted">Les techniciens actifs peuvent être bénéficiaires, même sans affectation à ce magasin.</p></div>{% else %}<input type="hidden" name="consumer_id" value="{{ app.user.id }}"><p><strong>Bénéficiaire :</strong> vous-même ({{ app.user.name }}).</p>{% endif %}
{% include 'components/scanner.html.twig' with {mode:'select',select_id:'consumption-article',quantity_id:'consumption-quantity'} only %}
<div class="field"><label for="consumption-quantity">Quantité retirée (obligatoire)</label><input id="consumption-quantity" name="quantity" type="text" inputmode="numeric" pattern="[1-9][0-9]*" maxlength="16" value="{{ item.quantity }}" aria-describedby="consumption-unit" required><p id="consumption-unit" class="muted">Quantité positive en unités entières.</p></div>
<div class="field"><label for="consumption-reference">Référence d’intervention, chantier ou client (facultative)</label><input id="consumption-reference" name="reference" maxlength="255" value="{{ item.reference }}"></div>
<div class="field"><label for="consumption-comment">Commentaire (facultatif)</label><textarea id="consumption-comment" name="comment" rows="3" maxlength="2000">{{ item.comment }}</textarea></div>
<button class="button" type="submit" {% if stores is empty or articles is empty %}disabled{% endif %}>Enregistrer la consommation</button>
</form>
</section>
{% endblock %}
