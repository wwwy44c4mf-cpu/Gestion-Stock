{% extends 'base.html.twig' %}
{% block title %}Historique des consommations · Gestion de stock{% endblock %}
{% block content %}
<p class="muted">Les consommations anonymisées après un an ne figurent plus dans les vues personnelles. Une correction liée peut également en sortir avant un an. Les quantités restent dans les statistiques globales autorisées ; pour un retour ancien, contactez un gestionnaire du magasin d’origine.</p>
<div class="page-heading"><div><p class="eyebrow">CONSOMMATIONS</p><h1>{{ app.user.role == 'USER' ? 'Mes consommations' : 'Historique des consommations' }}</h1><p class="subtitle">{{ app.user.role == 'USER' ? 'Vos consommations, y compris celles enregistrées pour vous par un gestionnaire.' : 'Les consommations des magasins que vous pouvez consulter.' }}</p></div><a class="button" href="{{ path('consumptions_new') }}">Nouvelle consommation</a></div>
<p><a href="{{ path('consumptions_return_list') }}">Rendre des articles</a></p>
<section class="card"><form method="get" class="account-filters" aria-label="Filtrer les consommations">
{% for key,label in {'date_from':'Du','date_to':'Au'} %}<div class="field"><label for="history-{{ key }}">{{ label }} ({{ app.user.timezone }})</label><input type="date" name="{{ key }}" id="history-{{ key }}" value="{{ filters[key]|default('') }}"></div>{% endfor %}
<div class="field"><label for="history-store">Magasin</label><select id="history-store" name="store_id"><option value="">Tous les magasins de mon périmètre</option>{% for store in options.stores %}<option value="{{ store.id }}" {{ filters.store_id|default('') == store.id ? 'selected' : '' }}>{{ store.code }} · {{ store.name }}{{ store.active ? '' : ' (désactivé)' }}</option>{% endfor %}</select></div>
<div class="field"><label for="history-article">Article</label><select id="history-article" name="article_id"><option value="">Tous les articles</option>{% if filters.article_id|default('') and filters.article_id not in options.articles|map(item => item.id) %}<option selected value="{{ filters.article_id }}">Article sans consommation visible</option>{% endif %}{% for item in options.articles %}<option value="{{ item.id }}" {{ filters.article_id|default('') == item.id ? 'selected' : '' }}>{{ item.sku }} · {{ item.name }}</option>{% endfor %}</select></div>
<div class="field"><label for="history-category">Catégorie</label><select id="history-category" name="category_id"><option value="">Toutes les catégories</option>{% if filters.category_id|default('') and filters.category_id not in categories|map(item => item.id) %}<option selected value="{{ filters.category_id }}">Catégorie sans correspondance</option>{% endif %}{% for item in categories %}<option value="{{ item.id }}" {{ filters.category_id|default('') == item.id ? 'selected' : '' }}>{{ item.name }}{{ item.active ? '' : ' (désactivée)' }}</option>{% endfor %}</select><p class="muted">Catégorie actuelle de l’article, sans inclure automatiquement ses sous-catégories.</p></div>
{% if app.user.role != 'USER' %}<div class="field"><label for="history-consumer">Technicien bénéficiaire</label><select id="history-consumer" name="consumer_id"><option value="">Toutes les personnes de mon périmètre</option>{% if filters.consumer_id|default('') and filters.consumer_id not in options.people|map(person => person.id) %}<option selected value="{{ filters.consumer_id }}">Personne sans consommation visible</option>{% endif %}{% for person in options.people %}<option value="{{ person.id }}" {{ filters.consumer_id|default('') == person.id ? 'selected' : '' }}>{{ person.name }}</option>{% endfor %}</select></div>{% endif %}
<div class="field"><label for="history-sort">Trier par</label><select id="history-sort" name="sort">{% for value,label in {'created_at':'Date','quantity':'Quantité sortie'} %}<option value="{{ value }}" {{ filters.sort == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="field"><label for="history-order">Ordre</label><select id="history-order" name="order">{% for value,label in {'desc':'Décroissant','asc':'Croissant'} %}<option value="{{ value }}" {{ filters.order == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="field"><label for="history-limit">Résultats par page</label><input type="number" id="history-limit" name="limit" min="1" max="100" value="{{ filters.limit }}"></div>
<button class="button">Filtrer</button><a href="{{ path('consumptions_list',{store_id:''}) }}">Réinitialiser</a>
</form></section>
<section class="card" aria-label="Totaux des consommations filtrées"><h2>Totaux des résultats filtrés</h2><p><strong>{{ result.totals.consumed_quantity }} unité(s) sorties</strong> · <strong>{{ result.totals.returned_quantity }} unité(s) rendues</strong></p><p>Les lignes annulées ou remplacées ne contribuent pas aux totaux. Les retours valides liés aux consommations sélectionnées sont comptés quelle que soit leur date de retour.</p></section>
<section class="card"><p>{{ result.meta.total }} consommation(s) · Dates inclusives et heures en {{ app.user.timezone }}.</p>
<div class="table-scroll"><table><caption>Consommations et retours liés</caption><thead><tr><th>Date</th><th>Article / référence</th><th>Magasin</th><th>Opérateur</th><th>Bénéficiaire</th><th>Sortie</th><th>Retours liés</th><th>État</th><th>Détail</th></tr></thead><tbody>{% for item in result.data %}<tr><td>{{ item.created_at|date('d/m/Y H:i:s',app.user.timezone) }}</td><td>{{ item.article_sku }} · {{ item.article_name }}<br>{{ item.reference ?: 'Référence non renseignée' }}</td><td>{{ item.store_code }} · {{ item.store_name }}</td><td>{{ item.author_name }}</td><td>{{ item.consumer_name }}</td><td>{{ item.quantity }} unité(s)</td><td>{{ item.returned_quantity }} unité(s)</td><td>{{ {'valid':'Valide','cancelled':'Annulée','corrected':'Corrigée'}[item.status] }}</td><td><a href="{{ path('consumptions_receipt',{id:item.id}) }}">Consulter</a></td></tr>{% else %}<tr><td colspan="9">Aucune consommation ne correspond aux filtres.</td></tr>{% endfor %}</tbody></table></div>
{% include 'components/pagination.html.twig' with {page:result.meta.page,pages:result.meta.total_pages,route:'consumptions_list',parameters:filters|filter((value,key) => key != 'page')|merge({store_id:filters.store_id|default('')})} only %}
</section>
{% endblock %}
