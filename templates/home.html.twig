{% extends 'base.html.twig' %}
{% block title %}Tableau de bord · Gestion de stock{% endblock %}
{% block content %}
{% set personal = app.user.role == 'USER' %}
{% set scope = {store_id:filters.store_id|default('')}|merge(filters|filter((v,k) => k == 'category_id')) %}
{% set activity = scope|merge({date_from:filters.date_from|default(''),date_to:filters.date_to|default('')}) %}
<div class="page-heading"><div><p class="eyebrow">VUE D’ENSEMBLE</p><h1>{{ personal ? 'Mon tableau de bord' : 'Tableau de bord' }}</h1><p class="subtitle">{{ personal ? 'Vos consommations et retours personnels, dans les magasins d’origine encore actifs.' : 'Les stocks et l’activité de vos magasins autorisés.' }}</p></div><a href="{{ path('statistics_consumptions',activity) }}">Explorer les statistiques</a></div>
<section class="card statistics-section"><form method="get" class="account-filters" aria-label="Filtrer le tableau de bord">
{% for key,label in {'date_from':'Du','date_to':'Au'} %}<div class="field"><label for="dashboard-{{ key }}">{{ label }} ({{ app.user.timezone }})</label><input type="date" id="dashboard-{{ key }}" name="{{ key }}" value="{{ filters[key]|default('') }}"></div>{% endfor %}
<div class="field"><label for="dashboard-store">Magasin</label><select id="dashboard-store" name="store_id"><option value="">Tout mon périmètre</option>{% for store in stores %}<option value="{{ store.id }}" {{ filters.store_id|default('') == store.id ? 'selected' : '' }}>{{ store.code }} · {{ store.name }}{{ store.active ? '' : ' (désactivé)' }}</option>{% endfor %}</select></div>
<div class="field"><label for="dashboard-category">Catégorie</label><select id="dashboard-category" name="category_id"><option value="">Toutes les catégories</option>{% if filters.category_id|default('') and filters.category_id not in categories|map(item => item.id) %}<option selected value="{{ filters.category_id }}">Catégorie sans correspondance</option>{% endif %}{% for item in categories %}<option value="{{ item.id }}" {{ filters.category_id|default('') == item.id ? 'selected' : '' }}>{{ item.name }}{{ item.active ? '' : ' (désactivée)' }}</option>{% endfor %}</select></div>
<button class="button">Filtrer</button><a href="{{ path('home',{store_id:''}) }}">Réinitialiser</a></form></section>
{% if not personal %}
<section class="statistics-section" aria-labelledby="current-stock"><h2 id="current-stock">Situation actuelle</h2><p>Ces indicateurs décrivent le stock actuel, indépendamment des dates choisies. Les ruptures et sous-seuils sont comptés par article et magasin : un article concerné dans deux magasins compte deux fois. Les seuils sont personnalisés par article et magasin ; les ruptures peuvent aussi être sous seuil.</p>
<div class="metrics">
<article class="card"><h3>Articles actifs</h3><p class="statistics-total" data-indicator="active_articles">{{ data.active_articles }}</p><p>Catalogue commun, filtré par catégorie. Le magasin ne modifie pas ce total.</p><a href="{{ path('catalog_list',{status:'active'}|merge(filters|filter((v,k) => k == 'category_id'))) }}">Voir les articles actifs</a></article>
<article class="card"><h3>Références en rupture</h3><p class="statistics-total" data-indicator="out_of_stock_references">{{ data.out_of_stock_references }}</p><p>Quantité à zéro, y compris les articles sans mouvement ou désactivés.</p><a href="{{ path('stocks_list',scope|merge({status:'out_of_stock'})) }}">Voir les ruptures</a></article>
<article class="card"><h3>Seuil bas atteint</h3><p class="statistics-total" data-indicator="below_threshold_references">{{ data.below_threshold_references }}</p><p>Quantité inférieure ou égale au seuil bas configuré.</p><a href="{{ path('stocks_list',scope|merge({status:'below_threshold'})) }}">Voir les stocks sous seuil</a></article>
</div></section>
{% endif %}
<section class="statistics-section" aria-labelledby="period-activity"><h2 id="period-activity">{{ personal ? 'Mon activité sur la période' : 'Activité sur la période' }}</h2>
<p>Du {{ filters.date_from|default('début de l’historique') }} au {{ filters.date_to|default('dernier mouvement') }}, dates inclusives en {{ app.user.timezone }}. La catégorie correspond à la catégorie actuelle exacte de l’article.</p>
<p>Sorties et retours valides sont comptés à leur propre date. Les retours restent séparés et ne sont pas soustraits ; les opérations annulées ou remplacées sont exclues de ces quantités.</p>
<div class="metrics">
{% if not personal %}<article class="card"><h3>Mouvements enregistrés</h3><p class="statistics-total" data-indicator="movements_on_period">{{ data.movements_on_period }}</p><p>Tous les événements visibles du journal, y compris annulations et corrections. Un transfert compte une fois.</p><a href="{{ path('movements_list',activity) }}">Voir les mouvements de la période</a></article>{% endif %}
<article class="card"><h3>Unités consommées</h3><p class="statistics-total" data-indicator="consumed_quantity">{{ data.consumption.consumed_quantity }}</p><p>{{ data.consumption.movement_count }} consommation(s) valide(s) · unité entière</p><a href="{{ path('statistics_consumptions',activity) }}">Voir les consommations et statistiques</a></article>
<article class="card"><h3>Unités rendues</h3><p class="statistics-total" data-indicator="returned_quantity">{{ data.consumption.returned_quantity }}</p><p>{{ data.consumption.return_count }} retour(s) valide(s), à leur date réelle</p><a href="{{ path('statistics_consumptions',activity) }}">Voir les retours dans les statistiques</a></article>
</div></section>
{% if data.consumption.movement_count == 0 and data.consumption.return_count == 0 %}<p>Aucune consommation ni aucun retour dans cette période et ce périmètre.</p>{% endif %}
{% if not personal %}<section class="card statistics-section" aria-labelledby="dashboard-alerts"><h2 id="dashboard-alerts">Alertes en cours</h2><p>État actuel des alertes, selon le magasin et la catégorie choisis, indépendamment des dates d’activité.</p><div class="metrics"><div><h3>Critiques</h3><p class="statistics-total" data-indicator="critical_alerts">{{ data.critical_alerts }}</p><a href="{{ path('alerts_list',scope|merge({status:'active',level:'critical'})) }}">Voir les alertes critiques</a></div><div><h3>Stock bas</h3><p class="statistics-total" data-indicator="low_alerts">{{ data.low_alerts }}</p><a href="{{ path('alerts_list',scope|merge({status:'active',level:'low'})) }}">Voir les alertes de stock bas</a></div></div></section>{% endif %}
<p><a href="{{ path('consumptions_list',activity) }}">{{ personal ? 'Mon historique de consommation' : 'Historique des consommations' }}</a> · L’historique rattache les retours à leur consommation d’origine ; les statistiques les comptent à leur date réelle.</p>
{% endblock %}
