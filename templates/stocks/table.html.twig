<div class="table-scroll"><table><caption>Stocks des magasins autorisés</caption><thead><tr><th scope="col">Article</th><th scope="col">Magasin</th><th scope="col">Quantité</th><th scope="col">Unité</th><th scope="col">Disponibilité</th><th scope="col">Détail</th></tr></thead><tbody>
{% for stock in rows %}{% set article = labels.articles[stock.article_id] %}{% set store = labels.stores[stock.store_id] %}
<tr><td><a href="{{ path('catalog_article',{id:stock.article_id}) }}">{{ article.sku }} · {{ article.name }}</a>{{ article.active ? '' : ' (désactivé)' }}</td><td>{{ store.code }} · {{ store.name }}{{ store.active ? '' : ' (désactivé)' }}</td><td>{{ stock.quantity }}</td><td>unité</td><td>{% if stock.quantity == 0 %}En rupture{% elseif stock.critical_threshold is not null and stock.quantity <= stock.critical_threshold %}Critique{% elseif stock.low_threshold is not null and stock.quantity <= stock.low_threshold %}Bas{% else %}En stock{% endif %}</td><td><a href="{{ path('stocks_detail',{storeId:stock.store_id,articleId:stock.article_id}) }}">Consulter</a></td></tr>
{% else %}<tr><td colspan="6">Aucun stock ne correspond aux filtres.</td></tr>{% endfor %}
</tbody></table></div>
