{% extends 'base.html.twig' %}
{% block title %}Détail du stock · Gestion de stock{% endblock %}
{% block content %}
{% set article = labels.articles[stock.article_id] %}{% set store = labels.stores[stock.store_id] %}
<div class="page-heading"><div><p class="eyebrow">STOCK PAR MAGASIN</p><h1>{{ article.name }}</h1><p class="subtitle">{{ article.sku }} · {{ store.name }}</p></div><a href="{{ path('stocks_list',{store_id:stock.store_id}) }}">Retour aux stocks du magasin</a></div>
<section class="card"><h2>Quantité actuelle : {{ stock.quantity }} unité{{ stock.quantity > 1 ? 's' : '' }}</h2>
<p>Seuil bas : {{ stock.low_threshold is null ? 'Non configuré' : stock.low_threshold }} · Seuil critique : {{ stock.critical_threshold is null ? 'Non configuré' : stock.critical_threshold }}</p>
{% if is_granted('APP_THRESHOLD_WRITE',threshold_target) %}<p><a class="button" href="{{ path('stocks_thresholds',{storeId:stock.store_id,articleId:stock.article_id}) }}">Configurer les seuils</a></p>{% endif %}
{% if not article.active %}<p class="notice">Cet article est désactivé. Les nouvelles consommations sont interdites.</p>{% endif %}{% if not store.active %}<p class="notice">Ce magasin est désactivé. Aucun mouvement n’est autorisé.</p>{% endif %}
<a href="{{ path('catalog_article',{id:stock.article_id}) }}">Consulter l’article et son total autorisé</a>
<nav class="stock-actions" aria-label="Actions de stock pour cet article">
{% if can_register_consumption %}<a class="button" href="{{ path('consumptions_new',{store_id:stock.store_id,article_id:stock.article_id}) }}">Enregistrer une consommation</a>{% endif %}
{% if can_transfer %}<a class="button" href="{{ path('stocks_transfer_new',{source_store_id:stock.store_id,article_id:stock.article_id}) }}">Transférer du stock</a>{% endif %}
{% if can_adjust %}<a class="button" href="{{ path('stocks_adjustment_new',{store_id:stock.store_id,article_id:stock.article_id}) }}">Ajuster le stock</a>{% endif %}
{% if can_register_entry %}<a class="button" href="{{ path('stocks_entry_new',{store_id:stock.store_id,article_id:stock.article_id}) }}">Enregistrer une entrée</a>{% endif %}
</nav>
</section>
{% if history is not null %}<section class="card"><h2>Historique des variations dans ce magasin</h2><div class="table-scroll"><table><caption>Journal local de l’article</caption><thead><tr><th>Date</th><th>Mouvement</th><th>Variation en unités</th><th>Correction</th></tr></thead><tbody>
{% set types = {'entry':'Entrée','consumption':'Consommation','transfer':'Transfert','return':'Retour','adjustment':'Ajustement','inventory_adjustment':'Inventaire','reversal':'Annulation'} %}
{% for movement in history.data %}<tr><td>{{ movement.created_at|date('d/m/Y H:i',app.user.timezone) }}</td><td>{% if transfer_links[movement.id]|default(false) %}<a href="{{ path('stocks_transfer_receipt',{id:movement.id}) }}">{{ types[movement.type]|default(movement.type) }}</a>{% elseif movement.type == 'return' %}<a href="{{ path('consumptions_return_receipt',{id:movement.id}) }}">Retour</a>{% else %}{{ types[movement.type]|default(movement.type) }}{% endif %}</td><td>{{ movement.quantity > 0 ? '+' : '' }}{{ movement.quantity }}</td><td>{% set correction = correction_links[movement.id]|default(null) %}{% if correction and correction.editable %}<a href="{{ path('stocks_correct',{id:movement.id}) }}">Corriger</a>{% elseif correction and correction.replacement_id %}<a href="{{ path('stocks_correct',{id:correction.replacement_id}) }}">Corrigé</a>{% elseif correction and correction.reversed_by %}Annulé{% else %}—{% endif %}</td></tr>{% else %}<tr><td colspan="4">Aucun mouvement enregistré pour cet article dans ce magasin.</td></tr>{% endfor %}
</tbody></table></div>
{% include 'components/pagination.html.twig' with {page:history.meta.page,pages:history.meta.total_pages,route:'stocks_detail',parameters:filters|filter((value,key) => key != 'page')|merge({storeId:stock.store_id,articleId:stock.article_id})} only %}
</section>{% endif %}
{% endblock %}
