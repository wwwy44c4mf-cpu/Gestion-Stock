{% extends 'base.html.twig' %}
{% block title %}Inventaire · Gestion de stock{% endblock %}
{% block content %}
{% set statuses = {'draft':'Brouillon','in_progress':'En cours','pending_validation':'À valider','closed':'Clôturé','cancelled':'Annulé'} %}
<div class="page-heading"><div><p class="eyebrow">INVENTAIRE</p><h1>{{ labels.stores[inventory.store_id].name }}</h1><p class="subtitle">{{ statuses[inventory.status] }} · Créé le {{ inventory.created_at|date('d/m/Y H:i',app.user.timezone) }}</p></div><a href="{{ path('inventories_list',{store_id:inventory.store_id}) }}">Retour aux inventaires</a></div>
{% if inventory.status in ['in_progress','pending_validation'] %}<p class="notice">Les mouvements de ce magasin sont bloqués : entrées, consommations, retours, transferts et corrections. L’annulation libère le magasin sans changer les quantités.</p>{% elseif inventory.status == 'draft' %}<p class="notice">Les mouvements restent autorisés. Le démarrage fige les quantités de référence et bloque le magasin.</p>{% elseif inventory.status == 'cancelled' %}<p class="notice">Inventaire annulé le {{ inventory.cancelled_at|date('d/m/Y H:i',app.user.timezone) }}. Les quantités de stock sont conservées. Cette campagne reste consultable.</p>{% else %}<p class="notice">Inventaire clôturé le {{ inventory.closed_at|date('d/m/Y H:i',app.user.timezone) }}. Cette campagne est conservée sans modification.</p>{% endif %}
{% if is_granted('APP_INVENTORY_WRITE',inventory_target) %}
{% if inventory.status == 'draft' %}<section class="card"><h2>Démarrer le comptage</h2><p>Vérifiez que personne n’a besoin d’enregistrer un mouvement dans ce magasin avant de démarrer.</p><form method="post" action="{{ path('inventories_transition',{id:inventory.id,action:'start'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('inventory_' ~ inventory.id ~ '_start') }}"><input type="hidden" name="_request_key" value="{{ request_key }}-start"><button class="button">Démarrer et bloquer les mouvements</button></form></section>{% endif %}
{% if inventory.status in ['draft','in_progress','pending_validation'] %}<section class="card"><h2>Annuler cette campagne</h2><p>La campagne et ses références seront conservées pour la traçabilité. Aucun ajustement de stock ne sera créé.</p><form method="post" action="{{ path('inventories_transition',{id:inventory.id,action:'cancel'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('inventory_' ~ inventory.id ~ '_cancel') }}"><input type="hidden" name="_request_key" value="{{ request_key }}-cancel"><button class="button">Annuler l’inventaire</button></form></section>{% endif %}
{% endif %}
{% if inventory.status == 'in_progress' and is_granted('APP_INVENTORY_WRITE',inventory_target) %}<section class="card"><h2>Avancement du comptage</h2><p>{{ progress.counted }} article{{ progress.counted > 1 ? 's' : '' }} compté{{ progress.counted > 1 ? 's' : '' }} sur {{ progress.total }}. {{ progress.remaining }} restant{{ progress.remaining > 1 ? 's' : '' }}.</p>{% if progress.remaining == 0 %}<p>Après soumission, les comptages ne sont plus modifiables. Le magasin reste bloqué jusqu’à la validation ou à l’annulation.</p><form method="post" action="{{ path('inventories_transition',{id:inventory.id,action:'submit'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('inventory_' ~ inventory.id ~ '_submit') }}"><input type="hidden" name="_request_key" value="{{ request_key }}-submit"><button class="button">Soumettre à validation</button></form>{% else %}<p>Comptez toutes les lignes avant de soumettre l’inventaire.</p>{% endif %}</section>{% endif %}
{% if inventory.snapshot_at %}<section class="card"><h2>Référence figée</h2><p>{{ lines.meta.total }} article{{ lines.meta.total > 1 ? 's' : '' }} · Stock au {{ inventory.snapshot_at|date('d/m/Y H:i:s',app.user.timezone) }} ({{ app.user.timezone }})</p>
<p>Une quantité non saisie reste distincte de zéro. Le pourcentage n’est pas défini lorsque le stock théorique est nul.</p><div class="table-scroll"><table><thead><tr><th>Référence</th><th>Article</th><th>Stock théorique</th><th>Quantité comptée</th><th>Écart</th><th>Écart (%)</th><th>Comptage</th></tr></thead><tbody>{% for line in lines.data %}<tr><td>{{ labels.articles[line.article_id].sku }}</td><td>{{ labels.articles[line.article_id].name }}{{ labels.articles[line.article_id].active ? '' : ' (désactivé)' }}</td><td>{{ line.theoretical_qty }}</td><td>{{ line.counted_qty is null ? 'Non saisie' : line.counted_qty }}</td><td>{{ line.delta is null ? '—' : (line.delta > 0 ? '+' : '') ~ line.delta }}</td><td>{{ line.delta_percent is null ? 'Non défini' : (line.delta > 0 ? '+' : '') ~ line.delta_percent|replace({'.':','}) ~ ' %' }}</td><td>{% if inventory.status == 'in_progress' and is_granted('APP_INVENTORY_WRITE',inventory_target) %}<a href="{{ path('inventories_count',filters|merge({id:inventory.id,articleId:line.article_id})) }}">{{ line.counted_qty is null ? 'Compter' : 'Modifier' }}</a>{% else %}Lecture seule{% endif %}</td></tr>{% else %}<tr><td colspan="7">Aucun article dans cette référence.</td></tr>{% endfor %}</tbody></table></div>
{% include 'components/pagination.html.twig' with {page:lines.meta.page,pages:lines.meta.total_pages,route:'inventories_detail',parameters:filters|filter((v,k) => k != 'page')|merge({id:inventory.id})} only %}</section>{% endif %}
{% endblock %}
