{% extends 'base.html.twig' %}
{% block title %}Alertes · Gestion de stock{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">SURVEILLANCE DES STOCKS</p><h1>Alertes</h1><p class="subtitle">Retrouvez les alertes en cours et leur historique.</p></div></div>
<section class="card"><form method="get" class="account-filters" aria-label="Filtrer les alertes">
<div class="field"><label for="alert-store">Magasin</label><select id="alert-store" name="store_id"><option value="">Tous mes magasins autorisés</option>{% for store in stores %}<option value="{{ store.id }}" {% if filters.store_id|default('') == store.id %}selected{% endif %}>{{ store.name }}{{ store.active ? '' : ' (désactivé)' }}</option>{% endfor %}</select></div>
<div class="field"><label for="alert-status">État</label><select id="alert-status" name="status">{% for key,label in {'active':'En cours','resolved':'Résolues','':'Tous les états'} %}<option value="{{ key }}" {% if filters.status|default('') == key %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
<div class="field"><label for="alert-level">Gravité</label><select id="alert-level" name="level">{% for key,label in {'':'Toutes les gravités','critical':'Critique','low':'Stock bas'} %}<option value="{{ key }}" {% if filters.level|default('') == key %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
<div class="field"><label for="alert-sort">Trier par</label><select id="alert-sort" name="sort"><option value="opened_at" {% if filters.sort == 'opened_at' %}selected{% endif %}>Date d’ouverture</option><option value="level" {% if filters.sort == 'level' %}selected{% endif %}>Gravité</option></select></div>
<div class="field"><label for="alert-order">Ordre</label><select id="alert-order" name="order"><option value="desc" {% if filters.order == 'desc' %}selected{% endif %}>Décroissant</option><option value="asc" {% if filters.order == 'asc' %}selected{% endif %}>Croissant</option></select></div>
{% if filters.article_id|default('') %}<input type="hidden" name="article_id" value="{{ filters.article_id }}">{% endif %}
<button class="button">Filtrer</button><a href="{{ path('alerts_list',{store_id:'',status:'active'}) }}">Réinitialiser</a></form>
<p>{{ result.meta.total }} alerte{{ result.meta.total > 1 ? 's' : '' }} dans les résultats.</p>
<div class="table-scroll"><table><caption>Alertes des magasins autorisés</caption><thead><tr><th>Ouverture</th><th>Magasin</th><th>Article</th><th>Gravité</th><th>Seuil</th><th>État</th><th>Résolution</th></tr></thead><tbody>{% for alert in result.data %}<tr><td>{{ alert.opened_at|date('d/m/Y H:i',app.user.timezone) }}</td><td>{{ labels.stores[alert.store_id].name }}</td><td><a href="{{ path('stocks_detail',{storeId:alert.store_id,articleId:alert.article_id}) }}">{{ labels.articles[alert.article_id].name }}</a><br>{{ labels.articles[alert.article_id].sku }}</td><td>{{ alert.level == 'critical' ? 'Critique' : 'Stock bas' }}</td><td>{{ alert.threshold }} unités</td><td>{{ alert.status == 'active' ? 'En cours' : 'Résolue' }}</td><td>{{ alert.closed_at is null ? '—' : alert.closed_at|date('d/m/Y H:i',app.user.timezone) }}</td></tr>{% else %}<tr><td colspan="7">Aucune alerte ne correspond aux filtres.</td></tr>{% endfor %}</tbody></table></div>
{% include 'components/pagination.html.twig' with {page:result.meta.page,pages:result.meta.total_pages,route:'alerts_list',parameters:filters|filter((v,k) => k != 'page')|merge({store_id:filters.store_id|default(''),status:filters.status|default('')})} only %}
</section>
<section class="card"><h2>Destinataires des courriels</h2><p>Personnalisez les personnes averties pour chaque magasin et type d’alerte.</p>{% for store in editable_stores %}<p><a href="{{ path('alerts_recipients',{id:store.id}) }}">Configurer les destinataires · {{ store.name }}</a></p>{% else %}<p>Aucun magasin actif autorisé à configurer.</p>{% endfor %}</section>
{% endblock %}
