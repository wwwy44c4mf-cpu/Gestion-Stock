{% extends 'base.html.twig' %}
{% block title %}Notifications · Gestion de stock{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Notifications</h1><p class="subtitle">Demandes de compte et propositions d’articles à examiner.</p></div><a href="{{ path('admin_users') }}">Retour aux comptes</a></div>
<section class="card"><p>La pastille compte vos notifications non lues. Ouvrir un dossier le marque comme lu pour vous ; il reste ici jusqu’à son traitement.</p>
{% for item in notifications %}<article class="card"><p class="eyebrow">{{ item.kind == 'account_request' ? 'DEMANDE DE COMPTE' : 'PROPOSITION D’ARTICLE' }}{% if item.read_at is null %} · NON LUE{% endif %}</p><h2>{{ item.title }}</h2><p>{{ item.created_at|date('d/m/Y à H:i','Europe/Paris') }}</p><a class="button" href="{{ path(item.kind == 'account_request' ? 'admin_users_requests_review' : 'proposals_detail',{id:item.id}) }}">Ouvrir le dossier</a></article>{% else %}<p>Aucune demande ni proposition en attente.</p>{% endfor %}
</section>
{% endblock %}
