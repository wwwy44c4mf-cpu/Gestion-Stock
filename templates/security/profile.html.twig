{% extends 'base.html.twig' %}
{% block title %}Mon profil · Gestion de stock{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">MON COMPTE</p><h1>Mon profil</h1><p class="muted">Vos informations et préférences personnelles.</p></div></div>
<section class="card auth-card" aria-labelledby="identity-title">
<h2 id="identity-title">Informations du compte</h2>
<dl class="profile-details"><dt>Nom</dt><dd>{{ profile.name }}</dd><dt>Courriel</dt><dd>{{ profile.email }}</dd><dt>Rôle</dt><dd>{{ {'ADMIN': 'Administrateur', 'MANAGER': 'Gestionnaire', 'USER': 'Utilisateur'}[profile.role] }}</dd><dt>Magasins affectés</dt><dd>{{ profile.storeIds|length }}</dd></dl>
<p class="muted">Votre administrateur gère votre identité et vos affectations.</p>
<form method="post" action="{{ path('profile') }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile') }}">
    <div class="field"><label for="timezone">Fuseau horaire</label>
    <select id="timezone" name="timezone" {% if error %}aria-invalid="true" aria-describedby="timezone-error"{% endif %}>
        {% for zone in timezones %}<option value="{{ zone }}" {% if zone == profile.timezone %}selected{% endif %}>{{ zone }}</option>{% endfor %}
    </select>{% if error %}<p class="field-error" id="timezone-error" role="alert">{{ error }}</p>{% endif %}</div>
    <div class="field"><label for="favorite-store">Magasin favori</label><select id="favorite-store" name="favorite_store_id"><option value="">Aucun magasin favori</option>{% for store in favorite_stores %}<option value="{{ store.id }}" {% if store.id == profile.favoriteStoreId %}selected{% endif %}>{{ store.code }} · {{ store.name }}</option>{% endfor %}</select><p class="muted">Proposé par défaut pour les opérations autorisées. Vous pouvez choisir un autre magasin sur chaque formulaire sans modifier ce favori.</p></div>
    <button type="submit" class="button primary">Enregistrer</button>
</form>
<p class="context-note">Votre session expire après 30 minutes d’inactivité ou 12 heures de connexion.</p>
</section>
{% endblock %}
