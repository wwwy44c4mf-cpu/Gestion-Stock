{% extends 'base.html.twig' %}
{% block title %}Connexion · Gestion de stock{% endblock %}
{% block content %}
<section class="auth-card card" aria-labelledby="login-title">
    <p class="eyebrow">VOTRE ESPACE</p>
    <h1 id="login-title">Connexion</h1>
    <p class="muted">Connectez-vous avec le compte fourni par votre administrateur.</p>
    <form method="post" action="{{ path('login') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('login') }}">
        <div class="field"><label for="email">Courriel</label><input id="email" name="email" type="email" autocomplete="username" maxlength="254" required autofocus></div>
        <div class="field"><label for="password">Mot de passe</label><input id="password" name="password" type="password" autocomplete="current-password" maxlength="128" required></div>
        <button type="submit" class="button primary">Se connecter</button>
    </form>
    <p class="context-note"><a href="{{ path('password_reset_request') }}">Mot de passe oublié ?</a> Pour obtenir un accès, contactez votre administrateur.</p>
</section>
{% endblock %}
