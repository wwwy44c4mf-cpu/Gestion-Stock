{% extends 'base.html.twig' %}{% block title %}Tourets de câble · Gestion de stock{% endblock %}{% block content %}
<h1>Tourets de câble</h1><p>Chaque touret possède sa propre référence et sa longueur restante en mètres entiers.</p>{% include 'curatif/tabs.html.twig' %}{% include 'curatif/store.html.twig' %}
{% if error %}{% include 'components/notice.html.twig' with {kind:'error',message:error} only %}{% endif %}
<div class="reel-grid">{% for item in items %}<section class="card"><h2>{{ item.reference }}</h2><p>{{ item.sku }} · {{ item.article_name }}</p><p class="reel-length"><strong>{{ item.remaining_length }} m</strong> restants sur {{ item.initial_length }} m</p><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('ca_reels') }}"><input type="hidden" name="store_id" value="{{ store_id }}"><input type="hidden" name="reel_id" value="{{ item.id }}"><input type="hidden" name="action" value="use"><input type="hidden" name="request_key" value="{{ request_key }}"><div class="field"><label>Mètres utilisés<input name="length" type="number" min="1" max="{{ item.remaining_length }}" required {{ item.remaining_length == 0 ? 'disabled' : '' }}></label></div><button class="button" {{ item.remaining_length == 0 ? 'disabled' : '' }}>Enregistrer l’utilisation</button></form></section>{% else %}<section class="card"><p>Aucun touret enregistré dans ce magasin.</p></section>{% endfor %}</div>
{% if can_manage and store_id %}<section class="card account-form"><h2>Réceptionner un touret</h2><p>À la création d’une catégorie, cochez « Suivi des tourets » pour les articles concernés.</p><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('ca_reels') }}"><input type="hidden" name="store_id" value="{{ store_id }}"><input type="hidden" name="action" value="receive"><input type="hidden" name="request_key" value="{{ request_key }}"><div class="field"><label>Article<select name="article_id" required>{% for article in articles %}<option value="{{ article.id }}">{{ article.sku }} · {{ article.name }}</option>{% endfor %}</select></label></div><div class="field"><label>Référence individuelle du touret<input name="reference" maxlength="80" required placeholder="TOURET-001"></label></div><div class="field"><label>Longueur reçue en mètres<input name="length" type="number" min="1" required placeholder="500"></label></div><button class="button" {{ articles is empty ? 'disabled' : '' }}>Enregistrer le touret</button></form></section>{% endif %}
{% endblock %}
