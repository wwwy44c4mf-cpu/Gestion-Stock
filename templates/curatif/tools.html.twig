{% extends 'base.html.twig' %}{% block title %}Outillage CA · Gestion de stock{% endblock %}{% block content %}
<h1>Outillage CA</h1><p>Curatif Antennaire · Chaque exemplaire est suivi séparément et se rend uniquement dans son magasin d’origine.</p>
{% include 'curatif/tabs.html.twig' %}{% include 'curatif/store.html.twig' %}
{% if error %}{% include 'components/notice.html.twig' with {kind:'error',message:error} only %}{% endif %}
{% if store_id %}<section class="card"><h2>Choisir les outils à emprunter</h2><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('ca_tools') }}"><input type="hidden" name="store_id" value="{{ store_id }}"><input type="hidden" name="action" value="borrow"><input type="hidden" name="request_key" value="{{ request_key }}">
<div class="tool-grid">{% for item in items %}<label class="tool-choice {{ item.loan_id ? 'tool-unavailable' : '' }}"><input type="checkbox" name="tools[]" value="{{ item.id }}" {{ item.loan_id ? 'disabled' : '' }}><span><strong>{{ item.name }}</strong><br>{{ item.reference }}<br>{{ item.loan_id ? 'Emprunté par '~item.borrower_name : 'Disponible' }}</span></label>{% else %}<p>Aucun outil dans ce magasin.</p>{% endfor %}</div><button class="button" {{ items is empty ? 'disabled' : '' }}>Emprunter la sélection</button></form></section>
<section class="card"><h2>Qui a quels outils ?</h2>{% for borrower_id,borrower in borrowers %}<div class="tool-loan"><div><p><strong>{{ borrower.name }}</strong> a les outils suivants :</p><ul>{% for item in borrower.items %}<li>{{ item.name }} · {{ item.reference }}</li>{% endfor %}</ul></div>{% if borrower_id == app.user.id or can_manage %}<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('ca_tools') }}"><input type="hidden" name="store_id" value="{{ store_id }}"><input type="hidden" name="borrower_id" value="{{ borrower_id }}">{% for item in borrower.items %}<input type="hidden" name="loans[]" value="{{ item.loan_id }}">{% endfor %}<button class="button" name="action" value="return_all">Rendre les outils</button></form>{% endif %}</div>{% else %}<p>Aucun emprunt en cours.</p>{% endfor %}</section>
{% if can_manage %}<section class="card account-form"><h2>Gestion de l’outillage</h2><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('ca_tools') }}"><input type="hidden" name="store_id" value="{{ store_id }}"><input type="hidden" name="action" value="add"><div class="field"><label>Nom de l’outil<input name="name" maxlength="160" required placeholder="Scie à métaux"></label></div><div class="field"><label>Référence des exemplaires<input name="reference" maxlength="70" required placeholder="SCIE"></label></div><div class="field"><label>Nombre d’exemplaires<input name="copies" type="number" min="1" max="50" value="1" required></label></div><button class="button">Ajouter les exemplaires</button></form><h3>Retirer un outil</h3>{% for item in items %}<form method="post" class="tool-loan"><input type="hidden" name="_csrf_token" value="{{ csrf_token('ca_tools') }}"><input type="hidden" name="store_id" value="{{ store_id }}"><input type="hidden" name="tool_id" value="{{ item.id }}"><span>{{ item.name }} · {{ item.reference }}</span><button class="button" name="action" value="remove" {{ item.loan_id ? 'disabled' : '' }}>Retirer</button></form>{% endfor %}<p>Un outil emprunté doit être rendu avant son retrait. Les emprunts terminés restent tracés.</p></section>{% endif %}{% endif %}
{% endblock %}
