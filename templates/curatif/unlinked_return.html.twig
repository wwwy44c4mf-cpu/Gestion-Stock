{% extends 'base.html.twig' %}{% block title %}Retour sans sortie préalable · Gestion de stock{% endblock %}{% block content %}
<h1>Retour sans sortie préalable</h1><p>Pour du matériel détenu avant la mise en place de l’application ou sans consommation enregistrée. Le dépôt sera tracé comme une réintégration en stock, sans inventer de sortie d’origine.</p>{% include 'curatif/tabs.html.twig' %}
<section class="card account-form">{% if error %}{% include 'components/notice.html.twig' with {kind:'error',message:error} only %}{% endif %}<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('unlinked_return') }}"><input type="hidden" name="request_key" value="{{ request_key }}"><div class="field"><label for="legacy-store">Magasin de dépôt<select id="legacy-store" name="store_id" required>{% for store in stores %}<option value="{{ store.id }}" {{ store_id == store.id ? 'selected' : '' }}>{{ store.name }}</option>{% endfor %}</select></label></div><div class="field"><label for="legacy-article">Article<select id="legacy-article" name="article_id" required><option value="">Choisir ou scanner un article</option>{% for article in articles %}<option value="{{ article.id }}" {{ article_id == article.id ? 'selected' : '' }}>{{ article.sku }} · {{ article.name }}</option>{% endfor %}</select></label></div>{% include 'components/scanner.html.twig' with {mode:'deposit',select_id:'legacy-article',quantity_id:'legacy-quantity'} only %}{% include 'components/location.html.twig' with {store_input:'legacy-store',article_input:'legacy-article'} only %}<div class="field"><label for="legacy-quantity">Quantité déposée<input id="legacy-quantity" name="quantity" value="{{ quantity }}" inputmode="numeric" pattern="[1-9][0-9]*" required></label></div><button class="button">Enregistrer ce retour sans sortie préalable</button></form></section>
{% endblock %}
