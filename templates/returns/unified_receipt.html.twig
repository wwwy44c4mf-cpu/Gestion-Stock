{% extends 'base.html.twig' %}{% block title %}Retour enregistré · Gestion de stock{% endblock %}{% block content %}
<h1>Retour enregistré</h1><section class="card"><h2>{{ article.sku }} · {{ article.name }}</h2><p><strong>Magasin de dépôt :</strong> {{ store.code }} · {{ store.name }}</p><p><strong>Quantité déposée :</strong> {{ deposit.quantity }} unité(s)</p><p><strong>Enregistré par :</strong> {{ app.user.name }}</p><p><strong>Date :</strong> {{ created_at|date('d/m/Y H:i',app.user.timezone) }}</p>{% if deposit.linked_quantity > 0 %}<p>{{ deposit.linked_quantity }} unité(s) rattachée(s) aux sorties enregistrées.</p>{% endif %}{% if deposit.unlinked_quantity > 0 %}<p>{{ deposit.unlinked_quantity }} unité(s) réintégrée(s) sans sortie préalable enregistrée.</p>{% endif %}</section><a class="button" href="{{ path('consumptions_return_batch_new') }}">Enregistrer un autre retour</a>
{% endblock %}
