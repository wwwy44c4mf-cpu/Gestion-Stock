{% extends 'base.html.twig' %}
{% block title %}Rendre des articles · Gestion de stock{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">RETOURS AU MAGASIN</p><h1>Rendre des articles</h1><p class="subtitle">Choisissez la consommation concernée. Les articles reviennent dans leur magasin d’origine.</p></div><a href="{{ path('consumptions_new') }}">Enregistrer une consommation</a></div>
<p><a href="{{ path('consumptions_list') }}">Historique des consommations</a></p>
<p><a class="button" href="{{ path('consumptions_return_batch_new') }}">Enregistrer un retour par article et quantité</a></p>
<section class="card">{% include 'components/scanner.html.twig' with {mode:'return'} only %}{% if article_filter %}<p>Consommations filtrées sur l’article scanné. <a href="{{ path('consumptions_return_list') }}">Afficher tous les articles</a></p>{% endif %}</section>
<section class="card"><h2>Consommations avec des unités à rendre</h2><p>{{ result.meta.total }} consommation{{ result.meta.total > 1 ? 's' : '' }}</p>
<div class="table-scroll returnable-scroll"><table class="returnable-table" role="table"><caption>Consommations autorisées avec un reste à rendre</caption><thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Date</th><th scope="col" role="columnheader">Article</th><th scope="col" role="columnheader">Magasin</th><th scope="col" role="columnheader">Bénéficiaire</th><th scope="col" role="columnheader">Unités à rendre</th><th scope="col" role="columnheader">Retour</th></tr></thead><tbody role="rowgroup">
{% for item in result.data %}<tr role="row"><td role="cell" data-label="Date">{{ item.created_at|date('d/m/Y H:i',app.user.timezone) }}</td><td role="cell" data-label="Article">{{ item.sku }} · {{ item.article_name }}{% if item.reference is not null and item.reference != '' %}<br>{{ item.reference }}{% endif %}</td><td role="cell" data-label="Magasin">{{ item.store_code }} · {{ item.store_name }}</td><td role="cell" data-label="Bénéficiaire">{{ item.consumer_name }}</td><td role="cell" data-label="Unités à rendre">{{ item.remaining }}</td><td role="cell" class="returnable-action"><a class="button" href="{{ path('consumptions_return_new',{id:item.id}) }}">Rendre des articles</a></td></tr>{% else %}<tr role="row"><td role="cell" colspan="6">Aucune consommation autorisée ne contient d’unités à rendre.</td></tr>{% endfor %}
</tbody></table></div>
{% include 'components/pagination.html.twig' with {page:result.meta.page,pages:result.meta.total_pages,route:'consumptions_return_list',parameters:article_filter ? {article_id:article_filter} : {}} only %}
</section>
{% endblock %}
