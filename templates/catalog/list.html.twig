{% extends 'base.html.twig' %}
{% block title %}{{ kind == 'article' ? 'Articles' : 'Catégories' }} · Gestion de stock{% endblock %}
{% block content %}
{% set can_manage = is_granted('APP_CATALOG_ADMIN') %}
{% set category_names = {} %}{% for category in categories %}{% set category_names = category_names|merge({(category.id):category.name}) %}{% endfor %}
<div class="page-heading"><div><p class="eyebrow">CATALOGUE COMMUN</p><h1>{{ kind == 'article' ? 'Articles' : 'Catégories' }}</h1><p class="subtitle">{{ kind == 'article' ? 'Vos fournitures, identifiées par une référence unique.' : 'Organisez le catalogue par catégories.' }}</p></div>{% if can_manage %}<a class="button" href="{{ path(kind == 'article' ? 'catalog_article_new' : 'catalog_category_new') }}">{{ kind == 'article' ? 'Créer un article' : 'Créer une catégorie' }}</a>{% endif %}</div>
<p><a href="{{ path(kind == 'article' ? 'catalog_categories' : 'catalog_list') }}">{{ kind == 'article' ? 'Consulter les catégories' : 'Retour aux articles' }}</a></p>
<section class="card">
<form method="get" class="account-filters" aria-label="Filtrer le catalogue">
{% if kind == 'article' %}<div class="field"><label for="catalog-query">Référence ou nom</label><input id="catalog-query" name="q" maxlength="160" value="{{ filters.q|default('') }}"></div><div class="field"><label for="catalog-category">Catégorie</label><select id="catalog-category" name="category_id"><option value="">Toutes les catégories</option>{% for category in categories %}<option value="{{ category.id }}" {% if filters.category_id|default('') == category.id %}selected{% endif %}>{{ category.name }}{{ category.active ? '' : ' (désactivée)' }}</option>{% endfor %}</select></div>{% endif %}
<div class="field"><label for="catalog-status">État</label><select id="catalog-status" name="status"><option value="">Tous les états</option><option value="active" {% if filters.status|default('') == 'active' %}selected{% endif %}>Actif</option><option value="inactive" {% if filters.status|default('') == 'inactive' %}selected{% endif %}>Désactivé</option></select></div>
<div class="field"><label for="catalog-sort">Trier par</label><select id="catalog-sort" name="sort">{% for value,label in (kind == 'article' ? {'sku':'Référence','name':'Nom','created_at':'Date de création'} : {'name':'Nom'}) %}<option value="{{ value }}" {% if filters.sort|default(kind == 'article' ? 'sku' : 'name') == value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></div>
<button class="button" type="submit">Filtrer</button><a href="{{ path(kind == 'article' ? 'catalog_list' : 'catalog_categories') }}">Réinitialiser</a>
</form>
<p>{{ result.meta.total }} {{ kind == 'article' ? 'article' : 'catégorie' }}{{ result.meta.total > 1 ? 's' : '' }}</p>
<div class="table-scroll"><table><caption>{{ kind == 'article' ? 'Articles du catalogue' : 'Catégories du catalogue' }}</caption><thead><tr>{% if kind == 'article' %}<th scope="col">Référence</th>{% endif %}<th scope="col">Nom</th><th scope="col">{{ kind == 'article' ? 'Catégorie' : 'Catégorie parente' }}</th><th scope="col">État</th>{% if kind == 'article' %}<th scope="col">Unité</th>{% endif %}{% if kind == 'article' or can_manage %}<th scope="col">Actions</th>{% endif %}</tr></thead><tbody>
{% for item in result.data %}{% set category_id = kind == 'article' ? item.category_id : item.parent_id %}<tr>{% if kind == 'article' %}<td>{{ item.sku }}</td>{% endif %}<td>{{ item.name }}</td><td>{{ category_names[category_id|default('')]|default('—') }}</td><td>{{ item.active ? 'Actif' : 'Désactivé' }}</td>{% if kind == 'article' %}<td>unité</td>{% endif %}{% if kind == 'article' or can_manage %}<td>{% if kind == 'article' %}<a href="{{ path('catalog_article',{id:item.id}) }}" aria-label="Consulter l’article {{ item.name }}">Consulter</a>{% endif %}{% if can_manage %} <a href="{{ path(kind == 'article' ? 'catalog_article_edit' : 'catalog_category_edit',{id:item.id}) }}" aria-label="Modifier {{ item.name }}">Modifier</a>{% endif %}</td>{% endif %}</tr>{% else %}<tr><td colspan="{{ kind == 'article' ? 6 : (can_manage ? 4 : 3) }}">Aucun résultat ne correspond aux filtres.</td></tr>{% endfor %}
</tbody></table></div>
{% include 'components/pagination.html.twig' with {page:result.meta.page,pages:result.meta.total_pages,route:kind == 'article' ? 'catalog_list' : 'catalog_categories',parameters:filters|filter((value,key) => key != 'page')} only %}
</section>
{% endblock %}
