{% extends 'base.html.twig' %}
{% block title %}{{ article.name }} · Gestion de stock{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">CATALOGUE COMMUN</p><h1>{{ article.name }}</h1><p class="subtitle">Référence : {{ article.sku }}</p></div><a href="{{ path('catalog_list') }}">Retour aux articles</a></div>
<section class="card"><p><strong>État :</strong> {{ article.active ? 'Actif' : 'Désactivé' }}</p><p><strong>Unité :</strong> unité</p><p><strong>Catégorie :</strong> {% set label = 'Aucune' %}{% for category in categories %}{% if category.id == article.category_id %}{% set label = category.name ~ (category.active ? '' : ' (désactivée)') %}{% endif %}{% endfor %}{{ label }}</p><h2>Description</h2><p class="catalog-description">{{ article.description ?: 'Aucune description.' }}</p>{% if not article.active %}<p class="notice">Cet article est désactivé. Les nouvelles consommations sont interdites.</p>{% endif %}{% if is_granted('APP_CATALOG_ADMIN') %}<a class="button" href="{{ path('catalog_article_edit',{id:article.id}) }}">Modifier l’article</a>{% endif %}</section>
{% endblock %}
