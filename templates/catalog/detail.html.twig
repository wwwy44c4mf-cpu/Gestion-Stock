{% extends 'base.html.twig' %}
{% block title %}{{ article.name }} · Gestion de stock{% endblock %}
{% block content %}
<div class="page-heading"><div><p class="eyebrow">CATALOGUE COMMUN</p><h1>{{ article.name }}</h1><p class="subtitle">Référence : {{ article.sku }}</p></div><a href="{{ path('catalog_list') }}">Retour aux articles</a></div>
<section class="card"><p><strong>État :</strong> {{ article.active ? 'Actif' : 'Désactivé' }}</p><p><strong>Unité :</strong> unité</p><p><strong>Catégorie :</strong> {% set label = 'Aucune' %}{% for category in categories %}{% if category.id == article.category_id %}{% set label = category.name ~ (category.active ? '' : ' (désactivée)') %}{% endif %}{% endfor %}{{ label }}</p><h2>Description</h2><p class="catalog-description">{{ article.description ?: 'Aucune description.' }}</p>{% if not article.active %}<p class="notice">Cet article est désactivé. Les nouvelles consommations sont interdites.</p>{% endif %}{% if is_granted('APP_CATALOG_ADMIN') %}<a class="button" href="{{ path('catalog_article_edit',{id:article.id}) }}">Modifier l’article</a>{% endif %}{% if is_granted('APP_CATALOG_PROPOSE') %}<p><a href="{{ path('proposals_new',{article_id:article.id}) }}">Proposer une modification</a> · <a href="{{ path('proposals_list') }}">Propositions du catalogue</a></p>{% endif %}</section>
<section class="card"><h2>Stock total autorisé : {{ stock_summary.total_quantity }} unités</h2><p>Calculé sur tous les magasins autorisés correspondant au filtre, avant pagination.</p>
{% include 'stocks/table.html.twig' with {rows:stock_summary.stores.data,labels:stock_labels} only %}
{% include 'components/pagination.html.twig' with {page:stock_summary.stores.meta.page,pages:stock_summary.stores.meta.total_pages,route:'catalog_article',parameters:stock_filters|filter((value,key) => key != 'page')|merge({id:article.id})} only %}
<p><a href="{{ path('stocks_list',{article_id:article.id}) }}">Filtrer les stocks de cet article par magasin</a></p>
</section>
{% endblock %}
