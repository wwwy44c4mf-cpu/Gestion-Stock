{% extends 'base.html.twig' %}
{% block title %}Proposition · Gestion de stock{% endblock %}
{% block content %}
{% set states = {'pending':'En attente','approved':'Approuvée','rejected':'Refusée'} %}
{% set category_names = {} %}{% for category in categories %}{% set category_names = category_names|merge({(category.id):category.name ~ (category.active ? '' : ' (désactivée)')}) %}{% endfor %}
<div class="page-heading"><div><p class="eyebrow">CATALOGUE COMMUN</p><h1>Proposition de {{ proposal.operation == 'create' ? 'création' : 'modification' }}</h1><p class="subtitle">{{ states[proposal.status] }} · Proposée par {{ author_name }} le {{ proposal.created_at|date('d/m/Y H:i',app.user.timezone) }}</p></div><a href="{{ path('proposals_list') }}">Retour aux propositions</a></div>
{% if current_article %}<p>Article concerné : <a href="{{ path('catalog_article',{id:current_article.id}) }}">{{ current_article.sku }} — {{ current_article.name }}</a></p>{% endif %}
{% if error %}{% include 'components/notice.html.twig' with {kind:'error',message:error} only %}{% endif %}
{% if blocking %}<p class="notice notice-error" role="alert">{{ blocking }} L’approbation est bloquée ; un refus motivé reste possible.</p>{% endif %}
<section class="card"><div class="table-scroll"><table><caption>Contenu de la proposition</caption><thead><tr><th scope="col">Champ</th><th scope="col">Publié aujourd’hui</th><th scope="col">Proposé</th></tr></thead><tbody>{% for field,label in {'sku':'Référence','name':'Nom','description':'Description','category_id':'Catégorie','unit_code':'Unité','active':'État'} %}{% if attribute(display_payload,field) is defined %}{% set proposed = attribute(display_payload,field) %}{% set current = current_article ? attribute(current_article,field) : null %}<tr><th scope="row">{{ label }}</th><td class="catalog-description">{% if not current_article %}—{% elseif field == 'category_id' %}{{ category_names[current|default('')]|default('Aucune') }}{% elseif field == 'active' %}{{ current ? 'Actif' : 'Désactivé' }}{% elseif field == 'unit_code' %}unité{% else %}{{ current is same as('') or current is null ? '—' : current }}{% endif %}</td><td class="catalog-description">{% if field == 'category_id' %}{{ category_names[proposed|default('')]|default('Aucune') }}{% elseif field == 'active' %}{{ proposed ? 'Actif' : 'Désactivé' }}{% elseif field == 'unit_code' %}unité{% else %}{{ proposed is same as('') or proposed is null ? '—' : proposed }}{% endif %}</td></tr>{% endif %}{% endfor %}</tbody></table></div>
{% if proposal.status != 'pending' %}<p>Décision de {{ reviewer_name }} le {{ proposal.reviewed_at|date('d/m/Y H:i',app.user.timezone) }}.</p>{% if proposal.review_comment is not null and proposal.review_comment is not same as('') %}<h2>Commentaire de décision</h2><p class="catalog-description">{{ proposal.review_comment }}</p>{% endif %}{% endif %}
{% if proposal.published_article_id %}<p><a href="{{ path('catalog_article',{id:proposal.published_article_id}) }}">Consulter l’article publié</a></p>{% endif %}
{% if is_granted('APP_CATALOG_ADMIN') and proposal.status == 'pending' %}<h2>Décision administrative</h2><form method="post" action="{{ path('proposals_decide',{id:proposal.id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('proposal_review_' ~ proposal.id) }}"><input type="hidden" name="_review_key" value="{{ review_key }}"><div class="field"><label for="review-comment">Commentaire (obligatoire en cas de refus)</label><textarea id="review-comment" name="comment" rows="3" maxlength="2000">{{ comment }}</textarea></div><div class="dialog-actions"><button class="button" type="submit" name="decision" value="approved" {% if blocking %}disabled{% endif %}>Approuver et publier</button><button class="button" type="submit" name="decision" value="rejected">Refuser la proposition</button></div></form>{% endif %}
{% if not is_granted('APP_CATALOG_ADMIN') and (proposal.status == 'rejected' or blocking) %}<p><a href="{{ path('proposals_new',proposal.article_id ? {article_id:proposal.article_id} : {}) }}">Faire une nouvelle proposition</a></p>{% endif %}
</section>
{% endblock %}
