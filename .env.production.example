# Aucun secret ici. Copier vers .env.production et adapter sur le serveur.
COMPOSE_PROJECT_NAME=gestion-stock-production
APP_ENV=prod
APP_DEBUG=0
APP_DOMAIN=stock.example.com
APP_TRUSTED_HOST_PATTERN='^stock[.]example[.]com\z'
APP_TRUSTED_PROXIES=10.253.240.2
# Identifiants immuables des versions construites et validées.
RELEASE_ID=remplacer-par-le-commit-teste
DATABASE_RELEASE_ID=remplacer-par-la-version-pg18-testee
POSTGRES_DB=gestion_stock
POSTGRES_USER=gestion_stock
MAIL_DELIVERY_ENABLED=0
MAIL_FROM_ADDRESS=noreply@example.invalid
HTTP_PORT=8080
HTTPS_BIND=0.0.0.0
ACME_EMAIL=administrateur@example.com
TLS_SUBNET=10.253.240.0/24
TLS_DYNAMIC_RANGE=10.253.240.128/25
TLS_PROXY_ADDRESS=10.253.240.2
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=90
BACKUP_COMMAND_TIMEOUT=600
BACKUP_TMPFS_SIZE=512m
BACKUP_RECOVERY_DIRECTORY=./backup-recovery
