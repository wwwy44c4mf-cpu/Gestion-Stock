# À adapter dans le proxy de l’hôte ; certificats gérés par son exploitant.
server {
    listen 80;
    server_name stock.example.com;
    return 308 https://stock.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name stock.example.com;
    ssl_certificate /chemin/certificat/fullchain.pem;
    ssl_certificate_key /chemin/certificat/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host stock.example.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
    }
}
