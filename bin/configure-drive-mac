#!/usr/bin/env python3
"""Configure the dedicated backup remote from Google's local Desktop OAuth JSON.

Secrets stay in a mode-0600 file, never in arguments or printed output.
Run interactively on the owner's Mac; this does not upload any backup.
"""
import argparse
import base64
import configparser
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def prepare(source, target, folder):
    if not re.fullmatch(r'[A-Za-z0-9_-]{10,200}', folder):
        raise ValueError('Identifiant du dossier Drive invalide.')
    if source.stat().st_size > 65536:
        raise ValueError('Le fichier choisi ne correspond pas au JSON client attendu.')
    value = json.loads(source.read_text())
    client = value.get('installed') if isinstance(value, dict) else None
    if not isinstance(client, dict):
        raise ValueError('Choisissez le JSON du client Google de type Application de bureau.')
    client_id = client.get('client_id', '')
    secret = client.get('client_secret', '')
    if not isinstance(client_id, str) or not re.fullmatch(r'[A-Za-z0-9_-]+\.apps\.googleusercontent\.com', client_id):
        raise ValueError('Identifiant client absent ou invalide dans le fichier choisi.')
    if not isinstance(secret, str) or not re.fullmatch(r'[A-Za-z0-9_-]+', secret):
        raise ValueError('Secret client absent ou invalide dans le fichier choisi.')
    if target.parent.is_symlink() or target.is_symlink():
        raise ValueError('Chemin de configuration non sûr.')
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    target.parent.chmod(0o700)
    if target.exists():
        current = configparser.ConfigParser(interpolation=None)
        current.read(target)
        if current.defaults() or set(current.sections()) - {'gestion_stock_drive'}:
            raise ValueError('Le fichier contient une autre connexion : aucune modification effectuée.')
    config = configparser.ConfigParser(interpolation=None)
    config['gestion_stock_drive'] = {
        'type': 'drive', 'client_id': client_id, 'client_secret': secret,
        'scope': 'drive', 'root_folder_id': folder,
    }
    fd, temporary = tempfile.mkstemp(prefix='.rclone-', dir=target.parent)
    try:
        with os.fdopen(fd, 'w') as handle:
            config.write(handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    choice = parser.add_mutually_exclusive_group(required=True)
    choice.add_argument('--folder')
    choice.add_argument('--copy-config', action='store_true')
    args = parser.parse_args()
    home = Path.home()
    binary = home / 'Applications/rclone-gestion-stock/rclone'
    target = home / '.config/gestion-stock/rclone.conf'
    if sys.platform != 'darwin' or not binary.is_file():
        print('Ce programme doit être lancé sur le Mac où rclone a été installé.', file=sys.stderr)
        return 1
    if args.copy_config:
        try:
            if target.is_symlink() or target.parent.is_symlink() or target.stat().st_mode & 0o077:
                raise ValueError('Permissions non privées.')
            text = target.read_text()
            config = configparser.ConfigParser(interpolation=None)
            config.read_string(text)
            if config.sections() != ['gestion_stock_drive'] or config.defaults():
                raise ValueError('Connexion inattendue.')
            settings = config['gestion_stock_drive']
            allowed = {'type', 'client_id', 'client_secret', 'scope', 'root_folder_id', 'token', 'team_drive'}
            if set(settings) - allowed or settings.get('type') != 'drive' or settings.get('scope') != 'drive' or settings.get('team_drive', ''):
                raise ValueError('Configuration inattendue.')
            token = json.loads(settings.get('token', ''))
            if not isinstance(token, dict) or not token.get('refresh_token') or not token.get('access_token'):
                raise ValueError('Autorisation Google incomplète.')
            subprocess.run(['/usr/bin/pbcopy'], input=base64.b64encode(text.encode()), check=True)
        except (OSError, ValueError, configparser.Error, subprocess.CalledProcessError):
            print('Copie refusée : vérifiez la connexion Google et les permissions du fichier privé.', file=sys.stderr)
            return 1
        print('Configuration privée copiée dans le presse-papiers. Collez-la uniquement dans la saisie masquée de Portainer, jamais dans cette conversation.')
        return 0
    try:
        choice = subprocess.run(['/usr/bin/osascript', '-e',
            'POSIX path of (choose file with prompt "Choisissez le fichier JSON client téléchargé depuis Google Cloud")'],
            capture_output=True, text=True, check=True)
        prepare(Path(choice.stdout.strip()), target, args.folder)
    except subprocess.CalledProcessError:
        print('Sélection annulée ; aucune connexion lancée.', file=sys.stderr)
        return 1
    except (OSError, ValueError, configparser.Error):
        print('Configuration refusée : vérifiez le JSON du client de bureau et le dossier de configuration. Aucun secret affiché.', file=sys.stderr)
        return 1
    print('Identifiants importés dans la configuration privée. Connexion Google…', flush=True)
    environment = {k: v for k, v in os.environ.items() if not k.startswith('RCLONE_')}
    os.execve(binary, [str(binary), 'config', 'reconnect', 'gestion_stock_drive:', '--config', str(target)], environment)


if __name__ == '__main__':
    sys.exit(main())
