#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
OPS_TEST_ROOT=$(mktemp -d /tmp/gestion-stock-ops03.XXXXXX)
export OPS_TEST_ROOT
OPS_TEST_PROJECT="gestion-stock-ops03-recette-$(date +%s)-$$"
COMPOSE_PROJECT_NAME="$OPS_TEST_PROJECT"
OPS_TEST_NETWORK="10.254.$(( $$ % 200 + 20 ))"
APP_DOMAIN=stock.example.test
APP_TRUSTED_HOST_PATTERN='^stock[.]example[.]test\z'
APP_TRUSTED_PROXIES="$OPS_TEST_NETWORK.2"
TLS_SUBNET="$OPS_TEST_NETWORK.0/24"
TLS_DYNAMIC_RANGE="$OPS_TEST_NETWORK.128/25"
TLS_PROXY_ADDRESS="$OPS_TEST_NETWORK.2"
RELEASE_ID=tested
DATABASE_RELEASE_ID=tested
POSTGRES_DB=gestion_stock
POSTGRES_USER=gestion_stock
MAIL_DELIVERY_ENABLED=0
ACME_EMAIL=recette@example.test
export COMPOSE_PROJECT_NAME APP_DOMAIN APP_TRUSTED_HOST_PATTERN APP_TRUSTED_PROXIES TLS_SUBNET TLS_DYNAMIC_RANGE TLS_PROXY_ADDRESS RELEASE_ID DATABASE_RELEASE_ID POSTGRES_DB POSTGRES_USER MAIL_DELIVERY_ENABLED ACME_EMAIL
PRODUCTION_ENV_FILE=$(mktemp /tmp/gestion-stock-ops03-env.XXXXXX)
PRODUCTION_PROXY_MODE=integrated
PRODUCTION_OVERRIDE_FILE=docker/production/compose.recette.yaml
export PRODUCTION_ENV_FILE PRODUCTION_PROXY_MODE PRODUCTION_OVERRIDE_FILE
built=0
compose() { docker compose --env-file "$PRODUCTION_ENV_FILE" -f compose.yaml -f compose.production.yaml -f compose.proxy-integrated.yaml -f "$PRODUCTION_OVERRIDE_FILE" "$@"; }
cleanup() {
    result=$?;trap - EXIT INT TERM
    compose --profile "*" stop >/dev/null 2>&1 || true
    if [ "$built" = 1 ]; then compose run --rm --no-deps fixture-setup clean >/dev/null 2>&1 || true; fi
    compose --profile "*" down --volumes --remove-orphans >/dev/null 2>&1 || true
    rm -f "$PRODUCTION_ENV_FILE";rmdir "$OPS_TEST_ROOT" 2>/dev/null || true
    exit "$result"
}
trap cleanup EXIT INT TERM
cat > "$PRODUCTION_ENV_FILE" <<ENV
COMPOSE_PROJECT_NAME=$OPS_TEST_PROJECT
APP_ENV=prod
APP_DEBUG=0
APP_DOMAIN=stock.example.test
APP_TRUSTED_HOST_PATTERN='$APP_TRUSTED_HOST_PATTERN'
APP_TRUSTED_PROXIES=$APP_TRUSTED_PROXIES
TLS_SUBNET=$TLS_SUBNET
TLS_DYNAMIC_RANGE=$TLS_DYNAMIC_RANGE
TLS_PROXY_ADDRESS=$TLS_PROXY_ADDRESS
POSTGRES_DB=gestion_stock
POSTGRES_USER=gestion_stock
RELEASE_ID=tested
DATABASE_RELEASE_ID=tested
ACME_EMAIL=recette@example.test
MAIL_DELIVERY_ENABLED=0
ENV
# Public dummy configuration only; readable by the unprivileged backup UID on Linux.
chmod 644 "$PRODUCTION_ENV_FILE"
compose build fixture-setup
built=1
compose run --rm --no-deps fixture-setup setup
compose run --rm --no-deps -e OPS_HOST_UID="$(id -u)" -e OPS_HOST_GID="$(id -g)" --entrypoint sh fixture-setup -ec 'chown "$OPS_HOST_UID:$OPS_HOST_GID" /fixture' 
compose build app web db backup proxy https-test ops-test
compose run --rm --no-deps tls-volume-init
compose up -d --wait db
compose run --rm --no-deps app php bin/console doctrine:migrations:migrate DoctrineMigrations\\Version20261021040000 --no-interaction
compose run --rm --no-deps app php bin/console messenger:setup-transports --no-interaction
compose run --rm --no-deps -e OPS_PRODUCTION_FIXTURE=1 app php docker/production/seed-recette.php
sh bin/production check
sh bin/production update
compose up -d --wait worker scheduler backup
# All services are healthy before the incident. Existing durable stock events are informational.
sh bin/production diagnostic
compose stop worker
compose run --rm --no-deps -e OPS_PRODUCTION_FIXTURE=1 app php docker/operations/seed-incident.php
if sh bin/production diagnostic > "$OPS_TEST_ROOT/worker-report.txt"; then echo 'Worker outage not detected' >&2;exit 1;fi
compose exec -T app php bin/console app:ops:status > "$OPS_TEST_ROOT/worker-status.json" || true
compose run --rm --no-deps ops-test report /fixture/worker-status.json worker
# Port 1 on this disposable container refuses SMTP; no external server is contacted.
compose run --rm --no-deps --entrypoint sh fixture-setup -ec 'printf "%s\\n" "smtp://private-marker:private-marker@127.0.0.1:1" > /fixture/secrets/mailer_dsn'
compose run --rm --no-deps -e MAIL_DELIVERY_ENABLED=1 worker php bin/console messenger:consume notifications --limit=1 --time-limit=15 --no-interaction > "$OPS_TEST_ROOT/consumer.log" 2>&1
compose exec -T app php bin/console app:ops:status > "$OPS_TEST_ROOT/smtp-status.json" || true
compose run --rm --no-deps ops-test report /fixture/smtp-status.json smtp
if compose run --rm --no-deps app php bin/console private-marker-command --no-interaction > "$OPS_TEST_ROOT/console.log" 2>&1; then exit 1;fi
compose run --rm --no-deps -e OPS_PRODUCTION_FIXTURE=1 app php docker/operations/sql-incident.php
compose run --rm --no-deps ops-http normal
compose stop web
compose run --rm --no-deps ops-http upstream
compose logs --no-color --tail=300 app worker scheduler web proxy db >> "$OPS_TEST_ROOT/consumer.log"
cat "$OPS_TEST_ROOT/console.log" >> "$OPS_TEST_ROOT/consumer.log"
compose run --rm --no-deps ops-test logs /fixture/consumer.log
compose stop db
if compose exec -T app php bin/console app:ops:status > "$OPS_TEST_ROOT/database-status.json"; then echo 'Database outage not detected' >&2;exit 1;fi
compose run --rm --no-deps ops-test report /fixture/database-status.json database
printf 'Panne worker, refus SMTP et journaux expurgés validés sur installation isolée.\n'
