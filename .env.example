# Copier vers .env ; valeurs locales uniquement, aucun secret ici.
COMPOSE_PROJECT_NAME=gestion-stock
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
APP_ENV=prod
APP_DEBUG=0
POSTGRES_DB=gestion_stock
POSTGRES_USER=gestion_stock

# Activer après configuration du secret .secrets/mailer_dsn et de l’expéditeur.
MAIL_DELIVERY_ENABLED=0
MAIL_FROM_ADDRESS=noreply@example.invalid
APP_PUBLIC_URL=http://localhost:8080

# OPS-01 : profil backup à activer après création et mise à l’abri de la clé.
# Fréquence en secondes : de 900 (15 min) à 86400 (1 jour).
BACKUP_INTERVAL_SECONDS=86400
# Rétention en jours : choix utilisateur confirmé.
BACKUP_RETENTION_DAYS=90
BACKUP_COMMAND_TIMEOUT=600
BACKUP_TMPFS_SIZE=512m
BACKUP_RECOVERY_DIRECTORY=./backup-recovery
